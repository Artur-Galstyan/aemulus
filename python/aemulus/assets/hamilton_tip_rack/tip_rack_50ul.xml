<!-- Hamilton tip rack, 96 tips of 50 uL in a grid of 8 x 12 with a 9 mm pitch.
     Sources: the rack body (122.4 x 82.6 x 20 mm) is from PyLabRobot. The tip length (50.4 mm) is from Hamilton.
     Origin: center of the footprint, on the bottom of the rack. x is the long side.
     The tips are one box over the 8 x 12 grid. The tips stand on the plane of the rack bottom, so the top of the tips is at 50.4 mm.
     Estimates, not vendor values: the mass of the loaded rack (150 g), the tip collar diameter (7 mm), and the height of the tips in the rack.
     All geoms are boxes. They are also the collision shapes. -->
<mujoco model="hamilton_tip_rack_50ul">
  <default>
    <geom type="box" contype="1" conaffinity="1"/>
  </default>

  <asset>
    <material name="hamilton_tip_rack_body" rgba="0.15 0.15 0.17 1" specular="0.3" shininess="0.4"/>
    <material name="hamilton_tip" rgba="0.9 0.9 0.88 0.6" specular="0.3" shininess="0.4"/>
  </asset>

  <worldbody>
    <body name="hamilton_tip_rack_50ul">
      <geom name="rack" size="0.0612 0.0413 0.01" pos="0 0 0.01" mass="0.15" material="hamilton_tip_rack_body"/>
      <geom name="tips" size="0.053 0.035 0.0252" pos="0 0 0.0252" mass="0" material="hamilton_tip"/>
    </body>
  </worldbody>
</mujoco>
