<!-- QInstruments BioShake 3000 elm (order number 2016-0017): orbital shaker for microplates.
     Shape: scripts/bioshake_meshes.py makes simple meshes from the datasheet dimensions. They are not vendor CAD.
     Vendor data: 142 x 99 x 55.35 mm, 1.6 kg, orbit diameter 2.0 mm, 200 to 3000 rpm.
     Origin: center of the footprint, on the mount surface. x is the long side.
     Shake: the crank turns and the plate moves on a circle with a 1 mm radius. The plate does not rotate.
     ELM (edge locking mechanism): four pins on levers, in two opposite corners, hold the microplate.
     In the model each corner moves in a straight line. The levers of the real device turn.
     Estimates, not vendor values: the masses, the height of the housing, the ELM travel (1.5 mm), and the ELM force.
     The meshes are for the display only. Boxes and cylinders are the collision shapes. -->
<mujoco model="bioshake">
  <compiler angle="degree" autolimits="true" meshdir="meshes"/>

  <default>
    <mesh scale="0.001 0.001 0.001"/>
    <geom type="mesh" contype="0" conaffinity="0" mass="0" material="bioshake_black"/>
    <default class="bioshake_collision">
      <geom type="box" contype="1" conaffinity="1" group="3"/>
    </default>
    <default class="bioshake_pin">
      <geom mesh="clamp" material="bioshake_steel"/>
    </default>
    <default class="bioshake_pin_collision">
      <geom type="cylinder" size="0.0011 0.0036" contype="1" conaffinity="1" group="3" mass="0.002" priority="1" solref="0.004 1"/>
    </default>
    <default class="bioshake_elm">
      <joint type="slide" range="0 0.002" armature="2" damping="630"/>
    </default>
  </default>

  <asset>
    <material name="bioshake_black" rgba="0.1 0.1 0.11 1" specular="0.3" shininess="0.4"/>
    <material name="bioshake_dark" rgba="0.2 0.2 0.22 1" specular="0.3" shininess="0.4"/>
    <material name="bioshake_steel" rgba="0.75 0.76 0.78 1" specular="0.6" shininess="0.7"/>
    <mesh file="housing.stl"/>
    <mesh file="plate.stl"/>
    <mesh file="clamp.stl"/>
  </asset>

  <worldbody>
    <body name="bioshake_housing">
      <geom name="housing" mesh="housing"/>
      <geom name="housing_collision" class="bioshake_collision" size="0.071 0.0495 0.01805" pos="0 0 0.01805" mass="1.3"/>

      <!-- shake = 0 is the zero position. There the plate is in the center of the housing. -->
      <body name="crank" pos="-0.001 0 0.0361">
        <joint name="shake" axis="0 0 1" armature="0.001"/>
        <geom name="crank" type="cylinder" size="0.005 0.0005" mass="0.01" group="3"/>

        <body name="shaker_plate" pos="0.001 0 0">
          <joint name="plate_counter" axis="0 0 1" armature="0.001"/>
          <geom name="plate" mesh="plate" material="bioshake_dark"/>
          <geom name="plate_collision" class="bioshake_collision" size="0.07 0.0475 0.005" pos="0 0 0.0085" mass="0.28" friction="0.6"/>
          <!-- The center of a locked microplate, on the top of the plate. -->
          <site name="nest" pos="-0.001 0 0.0135" size="0.002" rgba="1 0 0 1"/>

          <!-- elm = 0 is open. At elm = 0.0015 the pins touch a microplate of 127.76 x 85.48 mm. -->
          <body name="elm_a" pos="0.00106 0.00106 0.0135">
            <joint name="elm" class="bioshake_elm" axis="-1 -1 0"/>
            <geom name="pin_a1" class="bioshake_pin" pos="0.04515 0.0437 0"/>
            <geom name="pin_a2" class="bioshake_pin" pos="0.06384 0.025 0" euler="0 0 90"/>
            <geom name="pin_a1_collision" class="bioshake_pin_collision" pos="0.04515 0.0437 0.0036"/>
            <geom name="pin_a2_collision" class="bioshake_pin_collision" pos="0.06384 0.025 0.0036"/>
          </body>
          <body name="elm_b" pos="-0.00106 -0.00106 0.0135">
            <joint name="elm_b" class="bioshake_elm" axis="1 1 0"/>
            <geom name="pin_b1" class="bioshake_pin" pos="-0.04715 -0.0437 0" euler="0 0 180"/>
            <geom name="pin_b2" class="bioshake_pin" pos="-0.06584 -0.025 0" euler="0 0 -90"/>
            <geom name="pin_b1_collision" class="bioshake_pin_collision" pos="-0.04715 -0.0437 0.0036"/>
            <geom name="pin_b2_collision" class="bioshake_pin_collision" pos="-0.06584 -0.025 0.0036"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <!-- The plate turns back by the angle of the crank, so the plate does not rotate. -->
    <joint joint1="plate_counter" joint2="shake" polycoef="0 -1 0 0 0"/>
    <joint joint1="elm_b" joint2="elm" solref="0.004 1"/>
  </equality>

  <!-- shake: ctrl is the speed in rad/s (3000 rpm = 314.16). elm: ctrl is the travel in m, 0 = open, 0.002 = locked. -->
  <actuator>
    <velocity name="shake" joint="shake" kv="0.1" ctrlrange="0 314.16"/>
    <position name="elm" joint="elm" kp="50000" ctrlrange="0 0.002"/>
  </actuator>
</mujoco>
