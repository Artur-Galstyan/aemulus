<!-- Hamilton Microlab STARlet liquid handler.
     Configuration: 1 X arm, 8 independent pipetting channels, CO-RE gripper paddles (channels 6 and 7 fitted at home);
     no iSWAP, CO-RE 96 head, or autoload (not present in the reference STARlet configuration).
     Joints and position actuators (41 total, actuator name equals joint name):
       - x: pipetting arm X slide (-0.35 to 0.35 m, ref 0).
       - y0..y7: channel Y slides (-0.3345 to 0.2660 m; channel 0 back +y to channel 7 front -y).
       - z0..z7: channel Z slides (0.2000 to 0.5347 m, ref 0.35; paddle/pipette bottom Z).
       - plunger0..plunger7: channel dispense plunger slides (0 to 0.06 m, ref 0).
       - eject0..eject7: channel tip eject sleeve slides (0 to 0.01 m, ref 0).
       - paddle0..paddle7: CO-RE gripper paddle stow slides (0 = fitted at zN, 0.25 = parked; 6 and 7 fitted at home).
     Units: SI (meters, kg).
     Origin: center of the footprint on the floor (bench). +x is along the long side (left to right),
     -y is front (open side), +y is back, +z is up.
     Simple box and cylinder geoms are both the visual and collision shapes. The deck is one box.
     Frame mapping: x, y0..y7, and z0..z7 equal the channel position in the housing frame.
     y = -0.3345 m corresponds to firmware Y = 6.0 mm (y = 0.2660 m to firmware Y = 606.5 mm; 600.5 mm span).
     z = 0.2000 m corresponds to deck top / firmware Z = 0 mm (z = 0.5347 m to firmware Z = 334.7 mm).
     Channels 6 (+y) and 7 (-y) have paddle inner faces at y6 and y7 (inner gap = y6 - y7).
     Sourced values:
       - Overall dimensions: 1124 x 795 x 903 mm (W x D x H), Hamilton Microlab STARlet data sheet.
       - Free work area: 675 x 465 x 136 mm (30 tracks x 22.5 mm pitch = 675 mm), Hamilton data sheet and PyLabRobot:
         https://raw.githubusercontent.com/PyLabRobot/pylabrobot/main/pylabrobot/resources/hamilton/hamilton_decks.py
       - Carrier front edge offset: 63 mm, plus reference chassis depth 785.79 mm, modelled deck depth 773 mm,
         and deck resource 1005 x 653.5 mm from PyLabRobot (hamilton_decks.py above, and
         https://raw.githubusercontent.com/PyLabRobot/pylabrobot/main/pylabrobot/resources/hamilton/star_decks.py).
       - Pipetting channels: 8 independent channels, 9 mm minimum Y pitch, 600.5 mm Y span (firmware 6..606.5 mm),
         334.7 mm Z travel above deck.
     Estimates, not vendor values:
       - Total housing mass: 110 kg (base 65, deck 15, back wall 14, side walls 8 each); moving link masses and inertias.
       - Deck plate footprint: 0.675 x 0.465 m (using the sourced free work area, not a sourced physical deck plate size).
       - Deck top surface height above floor/bench: 0.200 m; deck box 0.020 m thick (z = 0.180 to 0.200 m);
         base block ends at deck underside (z = 0 to 0.180 m) to avoid overlap.
       - Deck box position: centered in x; front edge 0.063 m behind housing front (y = -0.3345 to +0.1305 m).
       - Housing shell: full-footprint base block with no separate feet; back and side walls 0.030 m thick from
         z = 0.180 to 0.903 m; open front and open top (top cover omitted).
       - X travel (-0.35 to 0.35 m, fit to housing/deck), arm beam, channel housings, pipette shafts,
         plunger travel (60 mm), tip eject travel (10 mm), CO-RE paddle dimensions (36 x 4 x 60 mm),
         and actuator gains/force limits. -->
<mujoco model="hamilton_starlet">
  <compiler angle="degree" autolimits="true"/>

  <default>
    <joint damping="1" armature="0.05"/>
    <geom type="box" contype="1" conaffinity="1" material="starlet_housing"/>
    <position inheritrange="1"/>
    <default class="starlet_decor">
      <geom contype="0" conaffinity="0"/>
    </default>
    <default class="starlet_y">
      <joint type="slide" axis="0 1 0" range="-0.3345 0.2660"/>
    </default>
    <default class="starlet_z">
      <joint type="slide" axis="0 0 1" range="0.20 0.5347" ref="0.35"/>
    </default>
    <default class="starlet_plunger">
      <joint type="slide" axis="0 0 1" range="0 0.06" ref="0" damping="0.2" armature="0.01"/>
    </default>
    <default class="starlet_eject">
      <joint type="slide" axis="0 0 1" range="0 0.01" ref="0" damping="0.2" armature="0.01"/>
    </default>
    <default class="starlet_paddle">
      <joint type="slide" axis="0 0 1" range="0 0.25" damping="0.5" armature="0.02"/>
    </default>
    <default class="starlet_paddle_geom">
      <geom type="box" size="0.018 0.002 0.030" mass="0.05" material="starlet_paddle" friction="2.5 0.01 0.001" condim="4" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>

  <asset>
    <material name="starlet_housing" rgba="0.9 0.9 0.91 1" specular="0.3" shininess="0.4"/>
    <material name="starlet_deck" rgba="0.75 0.76 0.78 1" specular="0.6" shininess="0.7"/>
    <material name="starlet_arm" rgba="0.20 0.45 0.75 1" specular="0.3" shininess="0.4"/>
    <material name="starlet_dark" rgba="0.25 0.28 0.32 1" specular="0.2"/>
    <material name="starlet_metal" rgba="0.78 0.80 0.84 1" specular="0.5" shininess="0.6"/>
    <material name="starlet_paddle" rgba="0.95 0.55 0.15 1" specular="0.3" shininess="0.4"/>
  </asset>

  <worldbody>
    <body name="starlet_housing">
      <!-- Full-footprint base block: x [-0.562, 0.562], y [-0.3975, 0.3975], z [0, 0.180]. -->
      <geom name="base" size="0.562 0.3975 0.090" pos="0 0 0.090" mass="65"/>

      <!-- Deck surface box (0.675 x 0.465 x 0.020 m): z [0.180, 0.200], front edge 0.063 m behind housing front.
