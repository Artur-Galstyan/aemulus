      <geom name="deck" size="0.3375 0.2325 0.010" pos="0 -0.102 0.190" mass="15" material="starlet_deck" contype="3"/>

      <!-- Back and side walls (0.030 m thick): z [0.180, 0.903], open at front (-y) and top. -->
